rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if true;
    }
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
    match /records/{recordId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
